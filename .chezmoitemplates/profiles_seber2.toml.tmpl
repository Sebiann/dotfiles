{{- /* ntfy_url is apprise-style: ntfys://tk_token@host/topic/ */ -}}
{{- $ntfy := urlParse .ntfy_url -}}
{{- $ntfy_http := printf "%s://%s%s" (ternary "http" "https" (eq $ntfy.scheme "ntfy")) $ntfy.host (trimSuffix "/" $ntfy.path) -}}
#:schema https://creativeprojects.github.io/resticprofile/jsonschema/config-1.json
#
# indentation is not needed but it makes it easier to read ;)
#
version = "1"

[default]
	default-command = "snapshots"
	initialize = false
	password-file = "$HOME/.config/resticprofile/password.txt"

	# success ping
	[default.backup.send-after]
		method = "POST"
		url = '{{ $ntfy_http }}?title=seber2%20${PROFILE_NAME}%20BACKUP%20OK'
		body = '${PROFILE_COMMAND} completed successfully'
		[[default.backup.send-after.headers]]
			name = "Authorization"
			value = 'Bearer {{ $ntfy.userinfo }}'
		[[default.backup.send-after.headers]]
			name = "Tags"
			value = "white_check_mark"

	# failure alert
	[default.backup.send-after-fail]
		method = "POST"
		url = '{{ $ntfy_http }}?title=seber2%20${PROFILE_NAME}%20BACKUP%20FAILED'
		body = """${ERROR} (exit ${ERROR_EXIT_CODE})
${ERROR_STDERR}"""
		[[default.backup.send-after-fail.headers]]
			name = "Authorization"
			value = 'Bearer {{ $ntfy.userinfo }}'
		[[default.backup.send-after-fail.headers]]
			name = "Priority"
			value = "urgent"
		[[default.backup.send-after-fail.headers]]
			name = "Tags"
			value = "rotating_light"

	[default.env]
		AWS_SECRET_ACCESS_KEY= {{ .aws_secret | quote }}
		AWS_ACCESS_KEY_ID= {{ .aws | quote }}

[groups]
	full-backup = [ "minecraft", "foundry", "dockers", "pelican", "dufs", "journey" ]

[minecraft]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2"
	exclude-file = "$HOME/.config/resticprofile/excludes.txt"
	
	[minecraft.backup]
		run-before = 'sh $HOME/Minecraft-Servers/scripts/run-before.sh'
		run-after = 'sh $HOME/Minecraft-Servers/scripts/run-after.sh'
		verbose = true
		source = [ "$HOME/Minecraft-Servers" ]
		schedule = "00:00"
		schedule-permission = "user"

[foundry]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2foundry"
	
	[foundry.backup]
		verbose = true
		source = [ "$HOME/import/foundrydata" ]
		schedule = "00:00"
		schedule-permission = "user"

[dockers]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2docker"
	exclude-file = "$HOME/.config/resticprofile/excludes-docker.txt"
	
	[dockers.backup]
		verbose = true
		source = [ "$HOME/.env", "$HOME/compose.yaml", "$HOME/docker-configs", "$HOME/docker-scripts" ]
		schedule = "00:00"
		schedule-permission = "user"


[pelican]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2pelican"
	
	[pelican.backup]
		verbose = true
		source = [ "$HOME/pelican/compose.yaml", "$HOME/pelican-backups" ]
		schedule = "00:00"
		schedule-permission = "user"

[dufs]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2dufs"
	
	[dufs.backup]
		verbose = true
		source = [ "$HOME/dufs" ]
		schedule = "00:00"
		schedule-permission = "user"

[journey]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2journey"
	
	[journey.backup]
		run-before = 'sh $HOME/Minecraft-Servers/scripts/before-journey.sh'
		run-after = 'sh $HOME/Minecraft-Servers/scripts/after-journey.sh'
		verbose = true
		source = [ "$HOME/Minecraft-Servers/journey" ]
		schedule = [ "04:59" ]
		schedule-permission = "user"
