{{- /* Uptime Kuma push tokens: [seber2] table in the encrypted .kuma-push.toml.asc */ -}}
{{- $kuma := dict -}}
{{- $kumaFile := joinPath .chezmoi.sourceDir ".kuma-push.toml.asc" -}}
{{- if stat $kumaFile -}}{{- $kuma = $kumaFile | include | decrypt | fromToml | dig "seber2" (dict) -}}{{- end -}}
#:schema https://creativeprojects.github.io/resticprofile/jsonschema/config-1.json
#
# indentation is not needed but it makes it easier to read ;)
#
version = "1"

[default]
	default-command = "snapshots"
	initialize = false
	password-file = "$HOME/.config/resticprofile/password.txt"

	[default.env]
		AWS_SECRET_ACCESS_KEY= {{ .aws_secret | quote }}
		AWS_ACCESS_KEY_ID= {{ .aws | quote }}

	[default.retention]
		after-backup = true
		keep-daily = 7
		keep-weekly = 4
		keep-monthly = 6
		prune = true

[groups]
	full-backup = [ "minecraft", "foundry", "dockers", "pelican", "dufs", "journey" ]

[minecraft]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2"
	exclude-file = "$HOME/.config/resticprofile/excludes.txt"

	[minecraft.backup]
		run-before = 'sh $HOME/Minecraft-Servers/scripts/run-before.sh'
		run-after = 'sh $HOME/Minecraft-Servers/scripts/run-after.sh'
		verbose = true
		source = [ "$HOME/Minecraft-Servers" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "minecraft" "tokens" $kuma) }}

[foundry]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2foundry"

	[foundry.backup]
		verbose = true
		source = [ "$HOME/import/foundrydata" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "foundry" "tokens" $kuma) }}

[dockers]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2docker"
	exclude-file = "$HOME/.config/resticprofile/excludes-docker.txt"

	[dockers.backup]
		verbose = true
		source = [ "$HOME/.env", "$HOME/compose.yaml", "$HOME/docker-configs", "$HOME/docker-scripts", "$HOME/dockhand" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "dockers" "tokens" $kuma) }}

[pelican]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2pelican"

	[pelican.backup]
		verbose = true
		source = [ "$HOME/pelican/compose.yaml", "$HOME/pelican-backups" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "pelican" "tokens" $kuma) }}

[dufs]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2dufs"

	[dufs.backup]
		verbose = true
		source = [ "$HOME/dufs" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "dufs" "tokens" $kuma) }}

[journey]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/seber2journey"

	[journey.backup]
		run-before = 'bash $HOME/Minecraft-Servers/scripts/journey-pull.sh'
		verbose = true
		source = [ "$HOME/Minecraft-Servers/journey" ]
		schedule = [ "05:59" ]
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "seber2" "profile" "journey" "tokens" $kuma) }}
