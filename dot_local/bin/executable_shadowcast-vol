#!/bin/sh
# Usage: shadowcast-vol + | - | <percent>   (no arg = show volume)
SRC=$(pw-cli ls Node | sed -n 's/.*node.name = "\(alsa_input\.usb-GENKI_ShadowCast[^"]*\)"/\1/p' | head -1)
ID=$([ -n "$SRC" ] && pw-cli i "$SRC" 2>/dev/null | awk '/id:/{print $2; exit}')
[ -n "$ID" ] || { echo "ShadowCast audio not found" >&2; exit 1; }

case "$1" in
  +) wpctl set-volume -l 1.0 "$ID" 5%+ ;;
  -) wpctl set-volume "$ID" 5%- ;;
  "") ;;
  *) wpctl set-volume -l 1.0 "$ID" "${1%\%}%" ;;
esac
wpctl get-volume "$ID"
