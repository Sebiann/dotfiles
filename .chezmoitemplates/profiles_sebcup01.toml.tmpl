{{- /* Uptime Kuma push tokens: [sebcup01] table in the encrypted .kuma-push.toml.asc */ -}}
{{- $kuma := dict -}}
{{- $kumaFile := joinPath .chezmoi.sourceDir ".kuma-push.toml.asc" -}}
{{- if stat $kumaFile -}}{{- $kuma = $kumaFile | include | decrypt | fromToml | dig "sebcup01" (dict) -}}{{- end -}}
#:schema https://creativeprojects.github.io/resticprofile/jsonschema/config-1.json
#
# indentation is not needed but it makes it easier to read ;)
#
version = "1"

[default]
	default-command = "snapshots"
	initialize = false
	password-file = "$HOME/.config/resticprofile/password.txt"

	[default.env]
		AWS_SECRET_ACCESS_KEY= {{ .aws_secret | quote }}
		AWS_ACCESS_KEY_ID= {{ .aws | quote }}

	[default.retention]
		after-backup = true
		keep-daily = 7
		keep-weekly = 4
		keep-monthly = 6
		prune = true

[dockers]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/sebcup01docker"
	exclude-file = "$HOME/.config/resticprofile/excludes-docker.txt"

	[dockers.backup]
		verbose = true
		source = [ "$HOME/.env", "$HOME/compose.yaml", "$HOME/docker-configs", "$HOME/docker-scripts" ]
		schedule = "00:00"
		schedule-permission = "user"
{{- template "kuma-hooks.tmpl" (dict "host" "sebcup01" "profile" "dockers" "tokens" $kuma) }}
