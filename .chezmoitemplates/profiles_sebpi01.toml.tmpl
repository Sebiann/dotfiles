#:schema https://creativeprojects.github.io/resticprofile/jsonschema/config-1.json
#
# indentation is not needed but it makes it easier to read ;)
#
version = "1"

[default]
	default-command = "snapshots"
	initialize = false
	password-file = "$HOME/.config/resticprofile/password.txt"

	# success ping — simple, no body needed
	[default.backup.send-after]
		method = "POST"
		url = '{{ .gotify_url }}/message?token={{ .gotify_token }}&title=sebpi01%20${PROFILE_NAME}%20BACKUP%20OK&message=${PROFILE_COMMAND}%20completed%20successfully&priority=3'	
	
	# failure alert
	[default.backup.send-after-fail]
		method = "POST"
    	url = '{{ .gotify_url }}/message?token={{ .gotify_token }}&title=sebpi01%20${PROFILE_NAME}%20BACKUP%20FAILED&message=${ERROR}%20(exit%20${ERROR_EXIT_CODE})%20%5Cn${ERROR_STDERR}&priority=8'
	
	[default.env]
		AWS_SECRET_ACCESS_KEY= {{ .aws_secret | quote }}
		AWS_ACCESS_KEY_ID= {{ .aws | quote }}

[groups]
	full-backup = [ "dockers" ]

[dockers]
	inherit = "default"
	repository = "s3:s3.eu-central-003.backblazeb2.com/sebpi01"
	
	[dockers.backup]
		verbose = true
		source = [ "$HOME/.env", "$HOME/compose.yaml", "$HOME/docker-configs", "$HOME/docker-scripts" ]
		schedule = "00:00"
		schedule-permission = "user"
